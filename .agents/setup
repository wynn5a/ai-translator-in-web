#!/usr/bin/env bash
set -euo pipefail

echo "[orb setup] Checking required tools"

packages=()
command -v node >/dev/null 2>&1 || packages+=(nodejs)
command -v python3 >/dev/null 2>&1 || packages+=(python3 python3-pip)

if ((${#packages[@]})); then
  echo "[orb setup] Installing: ${packages[*]}"
  sudo apt-get update
  sudo apt-get install -y "${packages[@]}"
fi

if ! python3 -c 'import PIL' >/dev/null 2>&1; then
  echo "[orb setup] Installing Pillow for the active Python interpreter"
  python3 -m pip install --user --disable-pip-version-check 'Pillow==11.3.0'
fi

echo "[orb setup] Verifying the Node.js test suite"
time node --test tools/test.js

echo "[orb setup] Ready"
